{
  "name": "@raquezha/nuecagram",
  "version": "0.9.3",
  "description": "Nuecagram simplifies GitLab webhook handling, delivering notifications directly to your Telegram.",
  "main": "index.js",
  "scripts": {
    "version": "changeset version && node -e \"require('fs').writeFileSync('version.txt', require('./package.json').version + '\\n')\"",
    "release": "git tag v$(node -p \"require('./package.json').version\") && git push origin v$(node -p \"require('./package.json').version\")",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/raquezha/nuecagram.git"
  },
  "keywords": [],
