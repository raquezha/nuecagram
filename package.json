  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/raquezha/nuecagram/issues"
  },
  "homepage": "https://github.com/raquezha/nuecagram#readme",
  "devDependencies": {
    "@changesets/cli": "^2.31.0"
  }
}
