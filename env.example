# Copy to .env and replace placeholders.
TELEGRAM_BOT_TOKEN=CHANGE_ME
TELEGRAM_WEBHOOK_SECRET=CHANGE_ME
PLATFORM_ADMIN_PASSWORD=CHANGE_ME
NUECAGRAM_PUBLIC_URL=https://example.com/nuecagram
NUECAGRAM_HEALTH_PATH=/nuecagram/health/ready
PORT=8080
DATABASE_URL=jdbc:postgresql://postgres:5432/nuecagram
DATABASE_USER=nuecagram
DATABASE_PASSWORD=CHANGE_ME
POSTGRES_DB=nuecagram
POSTGRES_USER=nuecagram
POSTGRES_PASSWORD=CHANGE_ME
NUECAGRAM_IMAGE=raquezha/nuecagram:latest
NUECAGRAM_POSTGRES_IMAGE=postgres:16-alpine
NUECAGRAM_BIND=8080:8080
